    <string name="troubleshoot_title_blocked">服务开关无法开启？</string>
    <string name="troubleshoot_desc_blocked">部分系统会限制从应用商店之外安装的应用，可按以下步骤检查：</string>
    <string name="troubleshoot_step_1">1. 点击下方按钮，打开应用信息。</string>
    <string name="troubleshoot_step_2">2. 点击右上角更多，选择「允许受限制的设置」（若有）。</string>
    <string name="troubleshoot_step_3">3. 完成身份验证，返回后再次检查无障碍开关。</string>
    <string name="troubleshoot_btn_grant">打开应用信息</string>
    <string name="troubleshoot_title_allowed">再次检查服务开关</string>
    <string name="troubleshoot_desc_allowed">当前无法确认受限状态。返回无障碍设置，检查连页服务能否开启。</string>
    <string name="troubleshoot_btn_return_a11y">返回设置</string>
    <string name="troubleshoot_return_hint">服务开关位于无障碍设置中，请返回那里开启。</string>
    <string name="about_title">帮助与设置</string>
    <string name="about_session_title">截图控制</string>
    <string name="about_session_desc">隐藏侧边按钮会保留截图能力；停用服务则关闭截图能力。</string>
    <string name="about_section_work">使用方式</string>
    <string name="about_section_work_tag">本地拼接</string>
    <string name="about_section_work_body">截取页面，在手机本地拼接。检查长图，可选裁剪，再保存或分享。</string>
    <string name="about_section_privacy">隐私与权限</string>
    <string name="about_privacy_offline_title">离线处理</string>
    <string name="about_privacy_offline_desc">屏幕图片只在本机处理。应用无网络权限、广告和追踪。</string>
    <string name="about_privacy_gesture_title">截取画面与滚动</string>
    <string name="about_privacy_gesture_desc">无障碍服务用于截取屏幕画面和模拟滚动，不读取控件树或记录按键。截图仍可能包含敏感内容。Android 10 还会请求屏幕捕获授权。</string>
    <string name="about_privacy_draft_desc">普通返回会保留当前草稿。新截图会替换它；保存写入相册，分享交给你选择的应用。</string>
    <string name="about_section_restricted">开关无法开启时</string>
    <string name="about_restricted_intro">部分 Android 系统会限制非应用商店安装的应用，具体入口因设备而异。</string>
    <string name="about_restricted_step1">1. 在无障碍设置中尝试开启连页，查看系统提示。</string>
    <string name="about_restricted_step2">2. 打开应用信息，在右上角更多中查找「允许受限制的设置」。</string>
    <string name="about_restricted_step3">3. 验证后返回无障碍设置，开启连页服务。</string>
