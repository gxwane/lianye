    <!-- 二级说明页 (About & Guide) 结构化卡片文案 -->
    <string name="about_title">关于与说明</string>
    <string name="about_section_work">运作方式</string>
    <string name="about_section_work_tag">本地拼接</string>
    <string name="about_section_work_body">悬浮窗触发后，系统自动匀速滚动页面并逐帧截取，在手机本地高速拼接为高清长图，即截即走。</string>

    <string name="about_section_privacy">隐私与权限</string>
    <string name="about_privacy_offline_title">纯离线运行</string>
    <string name="about_privacy_offline_desc">未申请任何网络权限，100% 本地运算。</string>
    <string name="about_privacy_gesture_title">手势无障碍</string>
    <string name="about_privacy_gesture_desc">仅用于模拟匀速滑动手势，不读取界面文本或按键。</string>

    <string name="about_section_restricted">开关置灰不可点击？</string>
    <string name="about_restricted_intro">针对非应用商店安装的软件，Android 默认锁定无障碍权限：</string>
    <string name="about_restricted_step1">1. 进入系统「应用信息」页</string>
    <string name="about_restricted_step2">2. 点击右上角「⋮」更多</string>
    <string name="about_restricted_step3">3. 选择「允许受限制的设置」并验证解锁凭据</string>
    <string name="btn_open_app_details">直达系统应用详情页 ›</string>
    <string name="btn_copy_adb_command">复制 ADB 解锁命令</string>
    <string name="toast_adb_copied">ADB 命令已复制至剪贴板！</string>
    <string name="btn_battery_optimization">配置电池优化白名单</string>

    <string name="about_section_meta">关于项目</string>
    <string name="about_meta_desc">自由开源，无广告，无后台驻留。\n遵循 Apache-2.0 协议 · v1.0.0 (Build 2026.09)</string>

    <!-- Android 10 录屏授权 -->
    <string name="media_projection_title">Android 10 屏幕捕获授权</string>
    <string name="media_projection_desc">检测到当前处于 Android 10 系统。需要额外授予一次屏幕捕获权限以启动底层 VirtualDisplay 流式合成。</string>
    <string name="btn_grant_media_projection">授权屏幕捕获</string>
    <string name="toast_media_projection_granted">屏幕捕获已授权，服务已就绪</string>
    <string name="toast_media_projection_denied">未授予截屏权限，长截屏无法启动</string>

    <!-- 兼容保留历史字段 -->
    <string name="privacy_section_title">架构级安全承诺</string>
    <string name="privacy_badge_zero_net">纯离线运行</string>
    <string name="privacy_badge_zero_net_sub">无网络权限</string>
    <string name="privacy_badge_blind">手势无障碍</string>
    <string name="privacy_badge_blind_sub">不读取文本</string>
    <string name="privacy_badge_local">本地合成</string>
    <string name="privacy_badge_local_sub">纯本地运行</string>
    <string name="guide_title">使用说明</string>
    <string name="guide_step_1">1. 开启无障碍服务，屏幕侧边显现悬浮窗；</string>
    <string name="guide_step_2">2. 切换至需要截图的目标页面；</string>
    <string name="guide_step_3">3. 轻触悬浮窗开始自动滚动截图；</string>
    <string name="guide_step_4">4. 再次轻触或触底自动结束并保存。</string>
    <string name="btn_restricted_settings_guide">受限制设置解锁指南</string>
    <string name="restricted_settings_desc">针对 Android 13+ 侧载应用，系统默认限制无障碍开关开启。\n1. 直达「应用信息」；\n2. 点击右上角「⋮ 更多」；\n3. 选择「允许受限制的设置」并验证解锁凭据。</string>
